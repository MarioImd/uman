# Apache + PHP-FPM con display_errors activado, parecido a un hosting con cPanel.
# Solo lo usa scripts/probar-paquete.mjs.
FROM php:8.1-fpm
COPY umam.ini /usr/local/etc/php/conf.d/umam.ini
COPY fpm-apache.conf /tmp/fpm-apache.conf
RUN docker-php-ext-install pdo_mysql \
 && apt-get update && apt-get install -y --no-install-recommends apache2 \
 && rm -rf /var/lib/apt/lists/* \
 && a2enmod proxy_fcgi rewrite headers \
 && mv /tmp/fpm-apache.conf /etc/apache2/conf-enabled/fpm.conf \
 && sed -i 's/AllowOverride None/AllowOverride All/' /etc/apache2/apache2.conf \
 && sed -i 's/display_errors = Off/display_errors = On/' /usr/local/etc/php/conf.d/umam.ini \
 && echo 'clear_env = no' >> /usr/local/etc/php-fpm.d/www.conf
CMD ["sh", "-c", "php-fpm -D && apache2ctl -D FOREGROUND"]
