# Plantilla de configuración. Cópiala como .env (que no se sube a git)
# y ajusta los valores según el entorno.

# Puerto donde escucha la API.
PORT=3000
# Origen del frontend autorizado por CORS.
CORS_ORIGIN=http://localhost:4200
# Tamaño máximo del JSON de un registro (incluye firmas e imágenes en base64).
BODY_LIMIT=50mb

# Conexión a PostgreSQL (coincide con docker-compose.yml).
DB_HOST=localhost
DB_PORT=5432
DB_USER=umam
DB_PASSWORD=umam
DB_NAME=umam
# true: TypeORM crea/actualiza las tablas al arrancar.
# En producción: false y usar migraciones.
DB_SYNCHRONIZE=true
